Opt : 2903
%symconst_1:i32 = var ; symconst_1
%1:i1 = ult 0:i32, %symconst_1
%v0:i8 = var ; v0
%3:i8 = width %v0
%4:i32 = zext %3
%5:i1 = ult %symconst_1, %4
%6:i1 = and %1, %5
pc %6 1:i1
%7:i32 = zext %v0
%8:i32 = ashr %7, %symconst_1
%9:i8 = trunc %8
infer %9
%10:i8 = trunc %symconst_1
%11:i8 = lshr %v0, %10
result %11

(0 <u C1) & (C1 <u zext(width(v0)))
  |= 
trunc((zext(v0) >>a C1))
  =>
v0 >>l trunc(C1)
