(set-logic ALL)
(declare-const u Int)
(declare-const r Int)
(declare-const q Int)
(declare-const t Int)
(declare-const p Int)
(declare-fun newvar1 () (_ BitVec p))
(declare-fun symconst_1 () (_ BitVec q))
(declare-fun symconst_2 () (_ BitVec r))

(assert (distinct 
    (psign_extend (- t q) (ite newvar1 symconst_1 symconst_2))
    (ite newvar1 (psign_extend (- t q) symconst_1) (psign_extend (- u r) symconst_2))
))
(check-sat)
